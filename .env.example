# EmailJS credentials for the contact form (https://dashboard.emailjs.com).
# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_.
# The public key is meant to be visible in the browser, so also restrict allowed
# domains and set a rate limit in the EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
